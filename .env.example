# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (leave blank = demo mode, nothing is charged) ──
# Cards, Apple Pay, Google Pay and Link come from the Payment Element.
# Apple Pay also needs your domain registered in the Stripe dashboard.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the dashboard
STRIPE_WEBHOOK_SECRET=
# Only for testing demo payments on a production build without Stripe
ALLOW_DEMO_PAYMENTS=false

# ── Google reviews (Places API "New") ───────────────────
# Without these, the home page shows the 4.6★ / 700+ summary and links to Google.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Dog wall moderation ─────────────────────────────────
# 12+ random characters. Used at /wall-of-fame/admin
ADMIN_TOKEN=

# ── Contact form forwarding (optional) ──────────────────
# Any endpoint that accepts JSON POST (Zapier, Make, Slack workflow, your email service)
CONTACT_WEBHOOK_URL=

# ── Hero video (optional) ───────────────────────────────
# Put a muted loop at public/media/hero-oven.mp4, then:
# NEXT_PUBLIC_HERO_VIDEO=/media/hero-oven.mp4

# ── Order types ─────────────────────────────────────────
# Set to "off" to hide Delivery at checkout
NEXT_PUBLIC_DELIVERY=on

# ── Storage ─────────────────────────────────────────────
# JSON files + uploaded photos live here. Use a persistent disk in production.
# DATA_DIR=./data
